{
  "schema_version": 2,
  "id": "bananapad",
  "name": "BananaPad",
  "game": "Donkey Kong 64 (N64, US 1.0) via static recompilation",
  "kind": "disc-translation",
  "status": "draft-untested",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "v64",
        "z64",
        "n64"
      ],
      "when": "build",
      "description": "Your own DK64 US 1.0 ROM (absolute path); prepared, decompressed and translated privately during the build."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental",
        "windows-arm64": "planned",
        "windows-x86_64": "planned"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "build",
          "command": [
            "/bin/bash",
            "{repo}/scripts/bootstrap-bananapad.sh",
            "--rom",
            "{disc}",
            "--target",
            "device"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/bin/cp",
            "{repo}/generated/packages/BananaPad-unsigned.ipa",
            "{output}"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "compile",
          "on": [
            "windows"
          ],
          "command": [
            "{python}",
            "{repo}/scripts/build-game-module.py",
            "--rom",
            "{disc}",
            "--toolchain",
            "{ios_toolchain}",
            "--build-dir",
            "{work}",
            "--jobs",
            "{jobs}"
          ]
        }
      ],
      "tools": [
        "git",
        "cmake",
        "ninja",
        "llvm",
        "libcxx",
        "mips-clang"
      ],
      "published_app": "BananaPad-v{version}-ios-shell.ipa",
      "ios_module": {
        "on": [
          "windows"
        ],
        "file": "{work}/module/BananaPadGame.dylib",
        "into": "BananaPadGame.dylib"
      }
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 25,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ],
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcrun",
        "label": "Metal Toolchain",
        "version_args": [
          "metal",
          "--version"
        ],
        "player": true,
        "note": "Install Xcode's Metal Toolchain: xcodebuild -downloadComponent MetalToolchain",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cpp-16",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "GNU cpp: brew install gcc",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "cargo",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "brew install rust",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "rustc",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "brew install rust",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "ripgrep, used by the packaging checks: brew install ripgrep",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "jq",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install jq, listed in README Requirements: brew install jq",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requiresAny",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "Microsoft.VisualStudio.Component.VC.Tools.ARM64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-arm64",
          "windows-x86_64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++ and a Windows SDK. x64 Windows needs x64/x86 C++ tools; Windows ARM64 can use ARM64 tools (preferred) or x64/x86 tools."
      }
    ]
  },
  "notes": "The existing full Mac recipe is preserved. Draft Windows module support requires the PadMint managed MIPS compiler and iOS minimum-version guard updates, plus a matching empty shell supplied with --app until audited publication is approved. See docs/WINDOWS_MODULE.md.",
  "publication": {
    "public_binaries": false,
    "reason": "Personal builds contain game code translated from the player's ROM; public releases are source only."
  }
}
